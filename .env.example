# Скопируйте в .env и при необходимости поменяйте значения:  cp .env.example .env
# Сам .env в .gitignore и в репозиторий не попадает.

# Обязательные секреты бэкенда (docker compose без них не стартует)
INTEGRITY_SALT=dev-integrity-salt-change-me
SECRET_KEY=dev-secret-key-change-me

# Порты на хосте (по умолчанию 8000 и 80; 80 может быть занят — например, OrbStack)
BACKEND_PORT=8000
FRONTEND_PORT=8080

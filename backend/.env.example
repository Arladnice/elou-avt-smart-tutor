# Скопируйте в backend/.env и при необходимости поменяйте значения:
#   cp backend/.env.example backend/.env
# Это делает и `make init`. Сам backend/.env в .gitignore и в репозиторий не попадает.

# Обязательные секреты. Значений по умолчанию у приложения нет намеренно:
# без них бэкенд падает на импорте, а не работает с предсказуемым ключом.
INTEGRITY_SALT=dev-integrity-salt-change-me
SECRET_KEY=dev-secret-key-change-me

# Адрес OpenAI-совместимого сервера LLM для ИИ-чата (LM Studio).
# Значение действует при локальном запуске без Docker. В docker-compose.yml
# оно переопределяется на host.docker.internal: внутри контейнера 127.0.0.1
# указывает на сам контейнер, а не на хост.
LLM_BASE_URL=http://127.0.0.1:1234
